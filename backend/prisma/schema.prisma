generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  products  Product[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("bodega")
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  movements Movement[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  sku         String
  name        String
  category    String   @default("")
  unit        String   @default("unidad")
  costPrice   Float    @default(0)
  stock       Int      @default(0)
  minStock    Int      @default(0)
  alertActive Boolean  @default(false)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  movements   Movement[]
  alerts      Alert[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sku, companyId])
}

model Movement {
  id         String   @id @default(uuid())
  type       String
  quantity   Int
  reason     String   @default("")
  supplier   String   @default("")
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Alert {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  currentStock Int
  minStock     Int
  sent         Boolean  @default(false)
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}
